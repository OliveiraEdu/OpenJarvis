# Copy to `.env` in this directory (deploy/docker/.env) before `docker compose up`.
# docker-compose.yml requires this — the container binds 0.0.0.0, so the
# server refuses to start without an API key.
#
# Generate a key with:  jarvis auth generate-key
# Then clients must send:  Authorization: Bearer <key>
OPENJARVIS_API_KEY=

# Host directory mounted at /workspace inside the container — projects
# developed with OpenJarvis live here. Must exist on the host; the container
# runs with the host uid/gid so files stay owned by the host user.
# Default: ~/Git/openjarvis-workspace
OPENJARVIS_WORKSPACE_HOST=

# Host directory mounted at /home/openjarvis/.openjarvis inside the container —
# the persistent Jarvis state (config.toml, memory.db, knowledge base, agents,
# skills). MUST exist on the host and be owned by the host user (uid 1001);
# otherwise container state is wiped on every `docker compose down`/rebuild.
# Default: ~/.openjarvis
OPENJARVIS_STATE_HOST=
