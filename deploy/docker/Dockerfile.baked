FROM nvidia/cuda:12.2.2-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies, Python 3.11, Rust, Node.js, and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    python3.11 \
    python3.11-dev \
    python3-pip \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default python/python3 binary
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Add virtual environment binaries directly to default PATH
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"

# Install Node.js v20.x
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy full project context
COPY ../../ /app

# Configure Vite Proxy to route /v1 -> 127.0.0.1:9000 (Eliminates CORS entirely at image level)
RUN node -e '\
const fs = require("fs");\
const path = "/app/frontend/vite.config.js";\
if (fs.existsSync(path)) {\
  let content = fs.readFileSync(path, "utf8");\
  if (!content.includes("proxy:")) {\
    content = content.replace("server: {", "server: {\\n    proxy: { \"/v1\": { target: \"http://127.0.0.1:9000\", changeOrigin: true } },");\
    fs.writeFileSync(path, content);\
  }\
}' || true

# Pre-install Python & Rust dependencies
RUN uv sync --extra desktop --extra tools-search
RUN uv run maturin develop -m rust/crates/openjarvis-python/Cargo.toml

# Pre-install Frontend dependencies
RUN cd frontend && npm install

EXPOSE 9000 5173

ENTRYPOINT ["/bin/bash", "-c", "cd /app && ./scripts/entrypoint.sh"]
