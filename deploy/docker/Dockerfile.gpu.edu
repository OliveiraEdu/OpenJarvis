FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04@sha256:af8bd179ed3bf69d4b63b19a763662a6141f0f62ef099283f68d0b14b4bab0e3 AS builder

# Prevent interactive prompts during apt installs & configure defaults
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    UV_PYTHON=3.11 \
    UV_VENV_CLEAR=1 \
    VITE_HOST=0.0.0.0 \
    VITE_API_BASE_URL=http://localhost:9000 \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:/root/.local/bin:$PATH"

# Install system dependencies, Python 3.11 via deadsnakes PPA, build tools, and Node.js v20
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        nano \
        ca-certificates \
        gnupg \
        software-properties-common \
        tzdata && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3.11-venv \
        python3-pip \
        build-essential && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install official stable Rust toolchain via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

WORKDIR /app

# Copy configuration and docs
COPY pyproject.toml README.md ./

# Copy all project directories
COPY src/ src/
COPY rust/ rust/
COPY scripts/ scripts/
COPY deploy/ deploy/
COPY frontend/ frontend/

# Ensure shell scripts have execute permissions
RUN chmod +x scripts/*.sh

# Install uv and maturin
RUN pip install --no-cache-dir uv maturin

# Install Python dependencies explicitly targeting Python 3.11
RUN uv python install 3.11 && \
    uv sync --python 3.11 --extra desktop --extra tools-search

# Build Rust extension
RUN uv run --python 3.11 maturin develop -m rust/crates/openjarvis-python/Cargo.toml

# Build Frontend
RUN cd frontend && npm install && npm run build

FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04@sha256:af8bd179ed3bf69d4b63b19a763662a6141f0f62ef099283f68d0b14b4bab0e3

# Prevent interactive prompts in final image as well
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    UV_PYTHON=3.11 \
    UV_VENV_CLEAR=1 \
    VITE_HOST=0.0.0.0 \
    VITE_API_BASE_URL=http://localhost:9000 \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:/root/.local/bin:$PATH"

# Install runtime dependencies, Python 3.11, and Node.js v20
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        nano \
        ca-certificates \
        gnupg \
        software-properties-common \
        tzdata \
        build-essential && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3.11-venv \
        python3-pip && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Copy Rust toolchain from builder stage
COPY --from=builder /usr/local/rustup /usr/local/rustup
COPY --from=builder /usr/local/cargo /usr/local/cargo

COPY --from=builder /usr/local /usr/local
COPY --from=builder /root/.local /root/.local
COPY --from=builder /app /app
WORKDIR /app

EXPOSE 9000 5173

ENTRYPOINT ["/bin/bash"]
