# ── OpenJarvis × llama.cpp binary comparison — configuration ──────────────
# Edit this file to point at your environment, then run ./run.sh

# Docker container running OpenJarvis (backend API on :9000)
CONTAINER_ID="675a6b4061e4"

# Stock llama.cpp build (currently used by the running OpenJarvis deployment)
STOCK_DIR="$HOME/Git/llama.cpp"

# Custom llama.cpp build (bin + lib are in a separate install prefix)
CUSTOM_DIR="$HOME/Git/custom-llama-bin"

# Model file served by both binaries (must be identical for a fair compare)
MODEL="$HOME/Git/llama.cpp/models/Qwen3-8B-Q3_K_M.gguf"
# Model id as exposed by the llama.cpp OpenAI-compatible endpoint
MODEL_ID="Qwen3-8B-Q3_K_M.gguf"

# llama-server port (swap binaries on the SAME port; container config untouched)
PORT=8080
# OpenJarvis backend API port (published on the host)
API_PORT=9000
# Container API key (from scripts/entrypoint.sh; can be overridden by env)
API_KEY="${OPENJARVIS_API_KEY:-oj_sk_container_default_key_0000000000000000}"

# Canonical server flags — identical for both binaries (mirrors the currently
# running deployment: ps aux | grep llama-server). Added --metrics so the
# server-side throughput cross-check works (approved by user).
SERVER_FLAGS=(
  --threads 12
  --threads-batch 8
  --ctx-size 20480
  --batch-size 512
  --ubatch-size 512
  --n-predict 8192
  --gpu-layers -1
  --kv-offload
  --flash-attn on
  --jinja
  --reasoning off
  --reasoning-budget 0
  --cache-type-k q8_0
  --cache-type-v q8_0
  --parallel 1
  --perf
  --metrics
)

# Where results land (results/ is gitignored)
RESULTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/results"
